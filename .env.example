# Copy to .env and adjust. Every setting is optional.

# Port on the host (docker compose) / port the server listens on (npm start).
HOST_PORT=8090
PORT=8090

# Any Sequelize connection URL. Empty = SQLite at SQLITE_PATH.
#   sqlite:data/flows.sqlite
#   postgres://user:pass@host:5432/db
#   mysql://user:pass@host:3306/db
#   mariadb://user:pass@host:3306/db
#   mssql://user:pass@host:1433/db
DATABASE_URL=
SQLITE_PATH=data/micro-flow-editor.sqlite
DB_LOGGING=false

# Stop HTTP Request nodes from reaching private, loopback and link-local
# addresses (SSRF guard). Turn on if the editor is reachable by others.
BLOCK_PRIVATE_NETWORKS=false

MAX_CONCURRENT_RUNS=10
MAX_LOOP_ITERATIONS=1000
MAX_EXECUTIONS_PER_FLOW=100

# Autosave: editor changes go into a cache and a background worker writes
# them to the database every FLUSH_INTERVAL_MS. The cache is in-process
# unless REDIS_URL is set (e.g. redis://redis:6379 with --profile redis).
REDIS_URL=
FLUSH_INTERVAL_MS=1000
# Snapshots kept per flow (Save creates one); 0 keeps them all.
MAX_SNAPSHOTS_PER_FLOW=100

# Optional sign-in, off by default. Leave AUTH_ENABLED empty to switch it on
# and off in the editor (Settings); set it to true/false to force it (the
# editor's switch is then locked). /webhook/* URLs never need a sign-in.
AUTH_ENABLED=
# Creates this account at startup if it doesn't exist (never changes one).
# Without it, turning sign-in on asks for the first account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
# Behind a reverse proxy: true, a hop count, or addresses (Express "trust
# proxy"), so client IPs and HTTPS (Secure cookies) come from X-Forwarded-*.
TRUST_PROXY=
